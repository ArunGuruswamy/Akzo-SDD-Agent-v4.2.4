    },
    "riskChurnLines": 200,
    "riskRules": [
      {
        "level": "high",
        "path": "\\.(csproj|fsproj|vbproj|sln|slnx)$",
        "reason": "project or solution file: changes what is built and referenced"
      },
      {
        "level": "high",
        "path": "(^|/)Directory\\.(Packages|Build)\\.(props|targets)$",
        "reason": "central package or build settings: affects every project"
      },
      {
        "level": "high",
        "path": "(^|/)[^/]*\\.runsettings$",
        "reason": "test and coverage settings: changes what the quality gate measures"
      }
    ]
  },
