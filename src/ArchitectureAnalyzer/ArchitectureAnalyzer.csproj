<Project Sdk="Microsoft.NET.Sdk">
  <!-- Akzo SDD Agent: Roslyn architecture analyzer. Developed and maintained by Arun RG. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Akzo.ArchitectureAnalyzer</AssemblyName>
    <RootNamespace>Akzo.ArchitectureAnalyzer</RootNamespace>
    <UseAppHost>false</UseAppHost>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Version>4.2.4</Version>
    <PathMap>$(MSBuildProjectDirectory)=/_/src/ArchitectureAnalyzer</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build" Version="17.11.48" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Build" Version="18.0.2" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net472'" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net472'" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>
</Project>
